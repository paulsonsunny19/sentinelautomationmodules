{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "2.3.2.0",
  "parameters": {
    "NamingType": {"type":"string","defaultValue":"default"},
    "STATFunctionName": {"type":"string","defaultValue":"stat-custom"},
    "STATStorageName": {"type":"string","defaultValue":"statcustom"},
    "STATConnectorName": {"type":"string","defaultValue":"SentinelTriageAssistantv2"},
    "STATConnectorDisplayName": {"type":"string","defaultValue":"STAT v2"},
    "storageAccountType": {"type":"string","defaultValue":"Standard_LRS"},
    "location": {"type":"string","defaultValue":"[resourceGroup().location]"},
    "MSGraphEndpoint": {"type":"string","defaultValue":"graph.microsoft.com"},
    "M365DEndpoint": {"type":"string","defaultValue":"api.security.microsoft.com"},
    "MDEEndpoint": {"type":"string","defaultValue":"api.securitycenter.microsoft.com"},
    "LogAnalyticsEndpoint": {"type":"string","defaultValue":"api.loganalytics.io"},
    "AzureResourceManagerEndpoint": {"type":"string","defaultValue":"management.azure.com"},
    "identityType": {"type":"string","defaultValue":"system","allowedValues":["system"]},
    "DeployBasicSample": {"type":"bool","defaultValue":false},
    "BasicSamplePlaybookName": {"type":"string","defaultValue":"Sample-STAT-Triage"}
  },
  "variables": {
    "functionName": "[if(equals(parameters('NamingType'),'custom'),parameters('STATFunctionName'),format('stat-{0}',uniqueString(resourceGroup().id)))]",
    "storageAccountName": "[if(equals(parameters('NamingType'),'custom'),parameters('STATStorageName'),format('stat{0}',uniqueString(resourceGroup().id)))]",
    "SystemIdFunctionTemplate": "https://raw.githubusercontent.com/paulsonsunny19/sentinelautomationmodules/stat-upstream-azure-fix/Function/SystemIdentity.json",
    "ConnectorTemplate": "https://raw.githubusercontent.com/briandelmsft/SentinelAutomationModules/main/Connector/connector.json",
    "BasicSampleTemplate": "https://raw.githubusercontent.com/briandelmsft/SentinelAutomationModules/main/Samples/basicsample.json",
    "AADTenantId": "[subscription().tenantId]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2022-05-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {"name":"[parameters('storageAccountType')]"},
      "kind": "Storage",
      "properties": {"allowBlobPublicAccess":false}
    },
    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "StageSTATFunctionPackage",
      "location": "[parameters('location')]",
      "kind": "AzureCLI",
      "identity": {"type":"SystemAssigned"},
      "dependsOn": ["[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"],
      "properties": {
        "azCliVersion": "2.61.0",
        "timeout": "PT20M",
        "cleanupPreference": "OnSuccess",
        "retentionInterval": "P1D",
        "forceUpdateTag": "stat-v2.3.0-c07e9031",
        "environmentVariables": [
          {"name":"STAT_STORAGE_ACCOUNT","value":"[variables('storageAccountName')]"},
          {"name":"STAT_STORAGE_KEY","secureValue":"[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2022-05-01').keys[0].value]"}
        ],
        "scriptContent": "set -euo pipefail\nPACKAGE_URL='https://github.com/briandelmsft/STAT-Function/releases/download/v2.3.0/stat.zip'\nEXPECTED_SHA='c07e9031d2ba7c0ca0ee2e14c2b520560c705a80cfce88aece57bdbf9a803b34'\ncurl -fL --retry 5 --retry-delay 3 -o /tmp/stat.zip \"$PACKAGE_URL\"\necho \"$EXPECTED_SHA  /tmp/stat.zip\" | sha256sum -c -\naz storage container create --name stat-package --account-name \"$STAT_STORAGE_ACCOUNT\" --account-key \"$STAT_STORAGE_KEY\" --public-access off --output none\naz storage blob upload --account-name \"$STAT_STORAGE_ACCOUNT\" --account-key \"$STAT_STORAGE_KEY\" --container-name stat-package --name stat.zip --file /tmp/stat.zip --overwrite true --output none\nEXPIRY=$(date -u -d '+365 days' '+%Y-%m-%dT%H:%MZ')\nSAS=$(az storage blob generate-sas --account-name \"$STAT_STORAGE_ACCOUNT\" --account-key \"$STAT_STORAGE_KEY\" --container-name stat-package --name stat.zip --permissions r --expiry \"$EXPIRY\" --https-only --output tsv)\nPACKAGE_BLOB_URL=\"https://${STAT_STORAGE_ACCOUNT}.blob.${AZURE_ENVIRONMENT_SUFFIXES_STORAGE:-core.windows.net}/stat-package/stat.zip?${SAS}\"\nprintf '{\"packageUrl\":\"%s\"}' \"$PACKAGE_BLOB_URL\" > \"$AZ_SCRIPTS_OUTPUT_PATH\""
      }
    },
    {
      "apiVersion": "2019-10-01",
      "name": "STATFunctionSystemId",
      "type": "Microsoft.Resources/deployments",
      "dependsOn": ["[resourceId('Microsoft.Resources/deploymentScripts','StageSTATFunctionPackage')]"],
      "properties": {
        "mode": "incremental",
        "templateLink": {"uri":"[variables('SystemIdFunctionTemplate')]","contentVersion":"1.0.0.0"},
        "parameters": {
          "STATFunctionName": {"value":"[variables('functionName')]"},
          "STATStorageName": {"value":"[variables('storageAccountName')]"},
          "location": {"value":"[parameters('location')]"},
          "FunctionPackage": {"value":"[reference('StageSTATFunctionPackage').outputs.packageUrl]"},
          "MSGraphEndpoint": {"value":"[parameters('MSGraphEndpoint')]"},
          "M365DEndpoint": {"value":"[parameters('M365DEndpoint')]"},
          "MDEEndpoint": {"value":"[parameters('MDEEndpoint')]"},
          "LogAnalyticsEndpoint": {"value":"[parameters('LogAnalyticsEndpoint')]"},
          "AzureResourceManagerEndpoint": {"value":"[parameters('AzureResourceManagerEndpoint')]"},
          "AADTenantId": {"value":"[variables('AADTenantId')]"},
          "STATConnectorName": {"value":"[parameters('STATConnectorName')]"},
          "STATConnectorDisplayName": {"value":"[parameters('STATConnectorDisplayName')]"},
          "ConnectorTemplate": {"value":"[variables('ConnectorTemplate')]"},
          "BasicSampleTemplate": {"value":"[variables('BasicSampleTemplate')]"},
          "DeployBasicSample": {"value":"[parameters('DeployBasicSample')]"},
          "BasicSamplePlaybookName": {"value":"[parameters('BasicSamplePlaybookName')]"}
        }
      }
    }
  ],
  "outputs": {
    "STATFunctionName": {"type":"string","value":"[variables('functionName')]"},
    "STATStorageName": {"type":"string","value":"[variables('storageAccountName')]"},
    "FunctionPackageBlob": {"type":"string","value":"[concat('https://', variables('storageAccountName'), '.blob.core.windows.net/stat-package/stat.zip')]"}
  }
}