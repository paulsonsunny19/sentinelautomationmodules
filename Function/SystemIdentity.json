{
  "$schema":"https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion":"2.3.1.0",
  "parameters":{
    "STATFunctionName":{"type":"string"},"STATStorageName":{"type":"string"},"location":{"type":"string"},"FunctionPackage":{"type":"string"},
    "UserIdentityResourceId":{"type":"string","defaultValue":""},"ServicePrincipalClientId":{"type":"string","defaultValue":""},"ServicePrincipalSecret":{"type":"securestring","defaultValue":""},"AADTenantId":{"type":"string"},
    "MSGraphEndpoint":{"type":"string"},"M365DEndpoint":{"type":"string"},"MDEEndpoint":{"type":"string"},"LogAnalyticsEndpoint":{"type":"string"},"AzureResourceManagerEndpoint":{"type":"string"}
  },
  "resources":[{
    "type":"Microsoft.Web/sites","apiVersion":"2022-03-01","name":"[parameters('STATFunctionName')]","location":"[parameters('location')]","kind":"functionapp,linux","identity":{"type":"SystemAssigned"},
    "properties":{"reserved":true,"httpsOnly":true,"siteConfig":{"linuxFxVersion":"PYTHON|3.12","appSettings":[
      {"name":"AzureWebJobsStorage","value":"[format('DefaultEndpointsProtocol=https;AccountName={0};EndpointSuffix={1};AccountKey={2}',parameters('STATStorageName'),environment().suffixes.storage,listKeys(resourceId('Microsoft.Storage/storageAccounts',parameters('STATStorageName')),'2023-05-01').keys[0].value)]"},
      {"name":"FUNCTIONS_EXTENSION_VERSION","value":"~4"},{"name":"FUNCTIONS_WORKER_RUNTIME","value":"python"},
      {"name":"WEBSITE_RUN_FROM_PACKAGE","value":"[parameters('FunctionPackage')]"},
      {"name":"GRAPH_ENDPOINT","value":"[parameters('MSGraphEndpoint')]"},{"name":"ARM_ENDPOINT","value":"[parameters('AzureResourceManagerEndpoint')]"},{"name":"LOGANALYTICS_ENDPOINT","value":"[parameters('LogAnalyticsEndpoint')]"},{"name":"M365_ENDPOINT","value":"[parameters('M365DEndpoint')]"},{"name":"MDE_ENDPOINT","value":"[parameters('MDEEndpoint')]"},{"name":"AZURE_TENANT_ID","value":"[parameters('AADTenantId')]"}
    ]}}
  }],
  "outputs":{"functionResourceID":{"type":"string","value":"[resourceId('Microsoft.Web/sites',parameters('STATFunctionName'))]"},"functionUrl":{"type":"string","value":"[reference(resourceId('Microsoft.Web/sites',parameters('STATFunctionName'))).defaultHostName]"}}
}
