{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "979592399242551024"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "minLength": 5,
      "metadata": {
        "description": "Use the same Name Prefix as the STAT Next core and playbook bootstrap deployments."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "sentinelSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]",
      "metadata": {
        "description": "Subscription containing the Microsoft Sentinel workspace."
      }
    },
    "sentinelResourceGroup": {
      "type": "string",
      "metadata": {
        "description": "Resource group containing the Microsoft Sentinel workspace."
      }
    },
    "sentinelWorkspaceName": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace used by Microsoft Sentinel."
      }
    }
  },
  "variables": {
    "functionName": "[format('{0}-api', parameters('namePrefix'))]",
    "playbookName": "[format('{0}-incident-triage', parameters('namePrefix'))]",
    "sentinelConnectionName": "[format('{0}-sentinel', variables('playbookName'))]",
    "sentinelManagedApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('sentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[variables('sentinelManagedApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('playbookName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "ProjectName": {
              "type": "String",
              "defaultValue": "STATNext"
            },
            "PlaybookVersion": {
              "type": "String",
              "defaultValue": "1.1.2"
            }
          },
          "triggers": {
            "When_Microsoft_Sentinel_incident_was_created": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Get_STAT_Next_incident_context": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "POST",
                "uri": "[format('https://{0}/api/incident_context', reference(resourceId('Microsoft.Web/sites', variables('functionName')), '2022-09-01').defaultHostName)]",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "subscriptionId": "[parameters('sentinelSubscriptionId')]",
                  "resourceGroup": "[parameters('sentinelResourceGroup')]",
                  "workspaceName": "[parameters('sentinelWorkspaceName')]",
                  "incidentId": "@{last(split(triggerBody()?['object']?['id'], '/'))}"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://management.azure.com/"
                }
              }
            },
            "Add_STAT_Next_comment_to_incident": {
              "type": "ApiConnection",
              "runAfter": {
                "Get_STAT_Next_incident_context": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "message": "@{concat('STAT Next triage completed. Correlation ID: ', body('Get_STAT_Next_incident_context')?['correlationId'])}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/Incidents/Comment"
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
                "connectionName": "[variables('sentinelConnectionName')]",
                "id": "[variables('sentinelManagedApiId')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]"
      ]
    }
  ],
  "outputs": {
    "playbookName": {
      "type": "string",
      "value": "[variables('playbookName')]"
    },
    "playbookState": {
      "type": "string",
      "value": "Enabled"
    },
    "sentinelConnectionName": {
      "type": "string",
      "value": "[variables('sentinelConnectionName')]"
    },
    "sentinelWorkspace": {
      "type": "string",
      "value": "[parameters('sentinelWorkspaceName')]"
    }
  }
}