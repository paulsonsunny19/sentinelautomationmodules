{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "2.2.0.0",
  "parameters": {
    "namePrefix": { "type": "string", "minLength": 5 },
    "location": { "type": "string", "defaultValue": "[resourceGroup().location]" },
    "sentinelSubscriptionId": { "type": "string", "defaultValue": "[subscription().subscriptionId]" },
    "sentinelResourceGroup": { "type": "string" },
    "sentinelWorkspaceName": { "type": "string" },
    "sentinelWorkspaceId": { "type": "string" },
    "mcasScoreThreshold": { "type": "int", "defaultValue": 0 },
    "relatedAlertsLookbackDays": { "type": "int", "defaultValue": 14 },
    "highScoreThreshold": { "type": "int", "defaultValue": 60 }
  },
  "variables": {
    "functionName": "[concat(parameters('namePrefix'), '-api')]",
    "playbookName": "[concat(parameters('namePrefix'), '-incident-triage')]",
    "connectionName": "[concat(variables('playbookName'), '-sentinel')]",
    "functionBaseUri": "[concat('https://', reference(resourceId('Microsoft.Web/sites', variables('functionName')), '2022-09-01').defaultHostName, '/api')]",
    "sentinelApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections", "apiVersion": "2016-06-01", "name": "[variables('connectionName')]", "location": "[parameters('location')]", "kind": "V1",
      "properties": { "displayName": "[variables('connectionName')]", "customParameterValues": {}, "parameterValueType": "Alternative", "api": { "id": "[variables('sentinelApiId')]" } }
    },
    {
      "type": "Microsoft.Logic/workflows", "apiVersion": "2019-05-01", "name": "[variables('playbookName')]", "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Web/connections', variables('connectionName'))]"], "identity": { "type": "SystemAssigned" },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#", "contentVersion": "2.2.0.0",
          "parameters": { "$connections": { "type": "Object", "defaultValue": {} }, "ProjectName": { "type": "String", "defaultValue": "STATNext" }, "PlaybookVersion": { "type": "String", "defaultValue": "2.2.0-full" } },
          "triggers": { "When_Microsoft_Sentinel_incident_was_created": { "type": "ApiConnectionWebhook", "inputs": { "body": { "callback_url": "@{listCallbackUrl()}" }, "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } }, "path": "/incident-creation" } } },
          "actions": {
            "Get_incident_context": { "type": "Http", "runAfter": {}, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/incident_context')]", "body": { "subscriptionId": "[parameters('sentinelSubscriptionId')]", "resourceGroup": "[parameters('sentinelResourceGroup')]", "workspaceName": "[parameters('sentinelWorkspaceName')]", "incidentId": "@{last(split(triggerBody()?['object']?['id'], '/'))}" }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "Build_STAT_Base": { "type": "Http", "runAfter": { "Get_incident_context": ["Succeeded"] }, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/stat_base')]", "body": { "entities": "@body('Get_incident_context')?['entities']", "incidentArmId": "@triggerBody()?['object']?['id']", "workspaceId": "[parameters('sentinelWorkspaceId')]", "tenantId": "@body('Get_incident_context')?['tenantId']" }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "AAD_Risks": { "type": "Http", "runAfter": { "Build_STAT_Base": ["Succeeded"] }, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/stat_aad_risks')]", "body": { "workspaceId": "[parameters('sentinelWorkspaceId')]", "base": "@body('Build_STAT_Base')", "lookbackDays": 14 }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "Related_Alerts": { "type": "Http", "runAfter": { "Build_STAT_Base": ["Succeeded"] }, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/stat_related_alerts')]", "body": { "workspaceId": "[parameters('sentinelWorkspaceId')]", "base": "@body('Build_STAT_Base')", "lookbackDays": "[parameters('relatedAlertsLookbackDays')]", "checkAccounts": true, "checkHosts": true, "checkIPs": true }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "Threat_Intelligence": { "type": "Http", "runAfter": { "Build_STAT_Base": ["Succeeded"] }, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/stat_threat_intel')]", "body": { "workspaceId": "[parameters('sentinelWorkspaceId')]", "base": "@body('Build_STAT_Base')", "lookbackDays": 14 }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "MDE": { "type": "Http", "runAfter": { "Build_STAT_Base": ["Succeeded"] }, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/stat_mde')]", "body": { "base": "@body('Build_STAT_Base')", "lookbackDays": 14 }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "UEBA": { "type": "Http", "runAfter": { "Build_STAT_Base": ["Succeeded"] }, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/stat_ueba')]", "body": { "workspaceId": "[parameters('sentinelWorkspaceId')]", "base": "@body('Build_STAT_Base')", "lookbackDays": 14, "minimumInvestigationPriority": 1 }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "File_Insights": { "type": "Http", "runAfter": { "Build_STAT_Base": ["Succeeded"] }, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/stat_file')]", "body": { "base": "@body('Build_STAT_Base')" }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "Defender_for_Cloud_Apps": { "type": "Http", "runAfter": { "Build_STAT_Base": ["Succeeded"] }, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/stat_mcas')]", "body": { "base": "@body('Build_STAT_Base')", "scoreThreshold": "[parameters('mcasScoreThreshold')]" }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "Score_STAT": { "type": "Http", "runAfter": { "AAD_Risks": ["Succeeded", "Failed"], "Related_Alerts": ["Succeeded", "Failed"], "Threat_Intelligence": ["Succeeded", "Failed"], "MDE": ["Succeeded", "Failed"], "UEBA": ["Succeeded", "Failed"], "File_Insights": ["Succeeded", "Failed"], "Defender_for_Cloud_Apps": ["Succeeded", "Failed"] }, "inputs": { "method": "POST", "uri": "[concat(variables('functionBaseUri'), '/stat_scoring')]", "body": { "inputs": [{"module":"@body('AAD_Risks')"},{"module":"@body('Related_Alerts')"},{"module":"@body('Threat_Intelligence')"},{"module":"@body('MDE')"},{"module":"@body('UEBA')"},{"module":"@body('File_Insights')"},{"module":"@body('Defender_for_Cloud_Apps')"}] }, "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" } } },
            "High_Risk": { "type": "If", "runAfter": { "Score_STAT": ["Succeeded"] }, "expression": { "greaterOrEquals": ["@body('Score_STAT')?['TotalScore']", "[parameters('highScoreThreshold')]"] }, "actions": { "Update_High_Risk_Incident": { "type": "ApiConnection", "inputs": { "body": { "incidentArmId": "@triggerBody()?['object']?['id']", "severity": "High", "tagsToAdd": { "TagsToAdd": [{"Tag":"STAT Next - High Risk"},{"Tag":"RiskScore:@{body('Score_STAT')?['TotalScore']}"}] } }, "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } }, "method": "put", "path": "/Incidents" } } }, "else": { "actions": { "Add_STAT_comment": { "type": "ApiConnection", "inputs": { "body": { "incidentArmId": "@triggerBody()?['object']?['id']", "message": "@{concat('STAT Next triage completed. Risk score: ', string(body('Score_STAT')?['TotalScore']), '. Related alerts: ', string(body('Related_Alerts')?['RelatedAlertsCount']), '. TI matches: ', string(body('Threat_Intelligence')?['MatchedTIItemCount']), '. UEBA anomalies: ', string(body('UEBA')?['AnomalyCount']), '. File threats: ', string(body('File_Insights')?['HashesLinkedToThreatCount']), '.')}" }, "host": { "connection": { "name": "@parameters('$connections')['azuresentinel']['connectionId']" } }, "method": "post", "path": "/Incidents/Comment" } } } } }
          }, "outputs": {}
        },
        "parameters": { "$connections": { "value": { "azuresentinel": { "connectionId": "[resourceId('Microsoft.Web/connections', variables('connectionName'))]", "connectionName": "[variables('connectionName')]", "id": "[variables('sentinelApiId')]", "connectionProperties": { "authentication": { "type": "ManagedServiceIdentity" } } } } } }
      }
    }
  ],
  "outputs": { "playbookName": { "type": "string", "value": "[variables('playbookName')]" }, "playbookState": { "type": "string", "value": "Enabled" } }
}
